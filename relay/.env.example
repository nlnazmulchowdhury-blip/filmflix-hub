# FilmFlix Relay configuration
# Manual run: copy to .env next to relay.mjs
# systemd:    copy to relay.env (see relay.service -> EnvironmentFile)

# Bind address. Keep 127.0.0.1 so only Nginx (HTTPS) can reach the relay.
RELAY_HOST=127.0.0.1
RELAY_PORT=8077

# Optional shared secret. When set, every URL must include ?k=<token>
# e.g. https://tv.example.com/c/news24/index.m3u8?k=YOUR-TOKEN
# RELAY_TOKEN=pick-a-long-random-string

# Segment cache size in MB (in-memory LRU). More = fewer repeat upstream fetches.
RELAY_CACHE_MAX_MB=600

# How long a fetched playlist may be reused (ms). Small = stays fresh for live.
RELAY_PLAYLIST_TTL_MS=1000

# Upstream fetch timeout (ms)
RELAY_UPSTREAM_TIMEOUT_MS=10000

# Optional: custom channels file location
# RELAY_CHANNELS_PATH=/opt/filmflix-relay/channels.json