.env.local
.env.development.local
.env.production
node_modules
dist

# relay runtime secrets / logs
relay/.env
relay/relay.env
relay/relay.log

# data migration artifacts (contain exported user data)
scripts/export/
scripts/data-export.zip
scripts/d1-import.sql

# Convex production deploy key — keep it local, never commit it
.convex-deploy-key
.convex-deploy-key.*
dev.log

# local tooling artifacts
__pycache__/
*.pyc
*.log
*.tsbuildinfo
.dev.pid
.wrangler/
worker/.wrangler-test/
tmp-ref/

# Bun lockfile — Pages must install with npm (package-lock.json).
# A tracked bun.lock makes the Pages build image choose Bun and the
# install step fails, killing the build before vite runs.
bun.lock
bun.lockb
