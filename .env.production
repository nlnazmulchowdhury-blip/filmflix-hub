# Committed production env values. This file is intentionally NOT secret:
# everything here is public-facing (browsers see the Convex cloud URL).
# Real secrets stay in untracked .env.local / the Convex dashboard.
#
# Hosted Convex deployment the production site talks to.
VITE_CONVEX_URL=https://energetic-pig-301.convex.cloud

# Convex HTTP endpoints base (video proxy, OIDC discovery). Must be the
# externally reachable deployment URL.
VITE_CONVEX_SITE_URL=https://energetic-pig-301.convex.cloud
